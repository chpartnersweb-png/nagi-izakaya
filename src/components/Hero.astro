---
import { Image } from 'astro:assets';
import hero from '../assets/generated/nagi-hero-concept-v1.png';
import logo from '../assets/generated/nagi-logo-sumi-v1.png';
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <Image class="hero-image" src={hero} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" data-hero-image />
  <div class="hero-shade"></div>
  <div class="hero-center">
    <Image class="hero-logo" src={logo} alt="凪 居酒屋" width={270} loading="eager" data-hero-logo />
    <h1 id="hero-title" data-hero-copy>米と魚、今夜は凪で。</h1>
  </div>
  <div class="hero-bottom"><p class="hero-access">日暮里駅直結<span>徒歩1分</span></p><a class="scroll-cue" href="#about"><span>SCROLL</span><span class="scroll-line"></span></a><small class="hero-image-note">イメージビジュアル</small></div>
  <span class="hero-side-note" aria-hidden="true">A LITTLE MOMENT, A GOOD EVENING.</span>
</section>
